# Ne partagez jamais ce fichier ni votre token. Ajoutez-le au .gitignore lorsque le dépôt GitHub sera créé.
DISCORD_TOKEN=remplacez_par_le_token_de_votre_bot
CLIENT_ID=remplacez_par_l_identifiant_de_votre_application

# Facultatif : avec un serveur de test, les commandes Slash se mettent à jour immédiatement.
# Laissez vide en production afin d'enregistrer des commandes globales.
TEST_GUILD_ID=

# Utilisé par Railway. Ne changez pas la valeur sans une raison précise.
NODE_ENV=production
